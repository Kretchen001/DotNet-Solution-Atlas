{
  "name": "dotnet-solution-atlas",
  "displayName": "DotNet Solution Atlas",
  "description": "Shows the classes, interfaces and their relationships of a C# or Visual Basic solution as an interactive map.",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "dotnet",
    "csharp",
    "visualbasic",
    "dependencies",
    "architecture",
    "graph",
    "roslyn"
  ],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dotnetAtlas",
          "title": "DotNet Solution Atlas",
          "icon": "media/atlas-activitybar.svg"
        }
      ]
    },
    "views": {
      "dotnetAtlas": [
        {
          "id": "dotnetAtlas.actions",
          "name": "Map"
        }
      ]
    },
    "commands": [
      {
        "command": "dotnetAtlas.openMap",
        "title": "Open map of the solution",
        "category": "DotNet Solution Atlas"
      },
      {
        "command": "dotnetAtlas.openSample",
        "title": "Open sample map",
        "category": "DotNet Solution Atlas"
      }
    ],
    "configuration": {
      "title": "DotNet Solution Atlas",
      "properties": {
        "dotnetAtlas.dotnetPath": {
          "type": "string",
          "default": "dotnet",
          "description": "Path or name of the dotnet executable used to run the analyzer."
        },
        "dotnetAtlas.zoomSpeed": {
          "type": "number",
          "default": 1,
          "minimum": 0.1,
          "maximum": 10,
          "description": "Speed of zooming with the mouse wheel in the map. 1 is the default, higher is faster. Takes effect the next time a map is opened."
        },
        "dotnetAtlas.namespaceGrouping": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "grouped",
            "nested"
          ],
          "enumDescriptions": [
            "Show the types without frames.",
            "Draw a frame around the types of each namespace.",
            "Like grouped, but a namespace frame is placed inside the frame of its parent namespace (Shop.Api inside Shop)."
          ],
          "description": "How the map shows namespaces when it is opened. Can be changed in the toolbar of the map."
        },
        "dotnetAtlas.analyzerPath": {
          "type": "string",
          "default": "",
          "description": "Path to Atlas.Analyzer.dll. Leave empty to use the analyzer bundled with the extension."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test",
    "build:analyzer": "dotnet publish ../analyzer/Atlas.Analyzer -c Release -o analyzer",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "cytoscape": "^3.30.2",
    "cytoscape-dagre": "^2.5.0",
    "dagre": "^0.8.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.0"
  }
}
